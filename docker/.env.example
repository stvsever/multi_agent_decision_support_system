# Copy to docker/.env. Compose reads it from the directory holding the compose
# file, so it is picked up automatically by every command in docker/README.md.
# Only OPENROUTER_API_KEY is required, and only on the hosted path.

# --- Hosted models (docker-compose.yml) --------------------------------------

OPENROUTER_API_KEY=
# Point this at any OpenAI-compatible endpoint to use something else.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=COMPASS

# --- Shared ------------------------------------------------------------------

# Host port for the dashboard and the API.
COMPASS_UI_PORT=5005
# Your participant folders. Mounted read only at /data; add /data as a data root
# in the dashboard. Defaults to the bundled synthetic samples.
COMPASS_DATA_DIR=
# Where run outputs land. A path mounts that folder; a bare name uses a Docker
# volume. Defaults to the compass-results volume.
COMPASS_RESULTS_DIR=
COMPASS_REQUEST_TIMEOUT=300
# Tool steps the Executor runs at once. Lower it on a self-hosted model, which
# serves one request at a time.
COMPASS_EXECUTOR_MAX_WORKERS=12

# --- Self-hosted weights (docker-compose.gpu.yml) ----------------------------

# Any HuggingFace repository vLLM can serve, or a path inside the mounted cache.
COMPASS_VLLM_MODEL=Qwen/Qwen3-14B-AWQ
# GPUs handed to the container. "all" gives it every visible device.
COMPASS_GPU_COUNT=all
# Splits one model across that many GPUs on this node. Must divide the model's
# attention head count and must not exceed COMPASS_GPU_COUNT. Across nodes, use
# src/full_stack/backend/hpc/06_serve_vllm.sh instead.
COMPASS_VLLM_TP=1
COMPASS_VLLM_PP=1
COMPASS_VLLM_MAX_MODEL_LEN=32768
COMPASS_VLLM_GPU_MEM_UTIL=0.90
# awq, gptq, fp8. Leave empty for an unquantised checkpoint.
COMPASS_VLLM_QUANT=
# Set to 0 to refuse to execute Python shipped by the model repository.
COMPASS_VLLM_TRUST_REMOTE_CODE=1
COMPASS_VLLM_EXTRA_ARGS=
# Only needed for gated repositories.
HF_TOKEN=
