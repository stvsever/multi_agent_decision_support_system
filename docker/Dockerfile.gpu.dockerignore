# BuildKit reads this file because the canonical .dockerignore sits in docker/
# rather than at the repository root, and the compose build context is the root.
# Keep it in step with .dockerignore and Dockerfile.dockerignore.

# Secrets and credentials. The ** prefix matters: a bare `.env` anchors to the
# context root, and the compose files keep theirs at docker/.env, which would
# otherwise be copied into the image by the wholesale source COPY.
**/.env
**/.env.*
*.pem
*.key

# Local working material, never part of an image.
report/
validation/

# Git and local tooling
.git
.gitignore
.idea
.vscode

# Web client sources: the image builds the bundle in its own stage.
node_modules/
src/full_stack/frontend/node_modules/

# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.ipynb_checkpoints/

# Outputs and generated artifacts
logs/
results/
outputs/
build/
dist/
*.egg-info/

# Local-only folders
tests/
src/tests/
local_tests/

# Heavy or deployment-specific folders not needed at runtime.
# Keep lightweight repository data modules (e.g., data/models) available.
data/__FEATURES__/
data/__pycache__/
src/full_stack/backend/hpc/
src/full_stack/backend/data/pseudo_data/outputs/
report/
validation/

# Documentation notebooks/assets not needed at runtime
*.ipynb

# macOS
.DS_Store
