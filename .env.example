# Required for the default OpenRouter backend.
# The dashboard can also store this key for you under ~/.compass.
OPENROUTER_API_KEY=

# Optional OpenRouter request metadata
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=COMPASS

# Optional. Structured decision models (Predictor role only) go through OpenRouter by
# default; set this and COMPASS_DECISION_PROVIDER=typesafe to call TypeSafe directly.
TYPESAFE_API_KEY=
COMPASS_DECISION_PROVIDER=openrouter

# Evidence routing: auto (orchestrate only when the record does not fit the
# Predictor input), always, or never.
COMPASS_ORCHESTRATION=auto

# Optional. Required only when selecting the OpenAI backend directly
OPENAI_API_KEY=

# Runtime defaults
EMBEDDING_MODEL=text-embedding-3-large
COMPASS_UI_HOST=127.0.0.1
COMPASS_UI_PORT=5005

# Engine tuning. The dashboard writes these per run; set them here for CLI runs.
COMPASS_EXECUTOR_MAX_WORKERS=12
COMPASS_REQUEST_TIMEOUT=300
COMPASS_REASONING_EFFORT=off

# Where the dashboard keeps its settings, credentials, and run history
COMPASS_HOME=
